APP_NAME="Cosmetic Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cosmetic_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log

# Local development uses Zarinpal sandbox. Never use the sandbox merchant in production.
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg/v4/payment
ZARINPAL_STARTPAY_URL=https://sandbox.zarinpal.com/pg/StartPay

SMS_PROVIDER=0098
SMS_BASE_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=
SMS_DOMAIN=0098
